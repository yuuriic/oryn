{
  "name": "@oryn/poc-webrtc-audio-lan",
  "private": true,
  "version": "0.0.0",
  "description": "POC-02A: áudio WebRTC bidirecional entre PC e celular na LAN (descartável)",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "certs": "node server/certs-cli.ts",
    "share-ca": "node server/share-ca.ts",
    "serve": "node server/index.ts",
    "start": "vite build && node server/index.ts",
    "e2e": "node scripts/e2e-two-browsers.mjs"
  },
  "dependencies": {
    "uqr": "0.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
