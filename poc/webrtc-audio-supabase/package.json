{
  "name": "@oryn/poc-webrtc-audio-supabase",
  "private": true,
  "version": "0.0.0",
  "description": "POC-02C: sinalização WebRTC por Supabase Realtime (fundação local 02C.1A; descartável)",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
