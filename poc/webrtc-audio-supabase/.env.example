# Cliente web da POC-02C (voz 1:1). Copie para `.env.local` (ignorado pelo Git) e preencha.
# Tudo aqui vai para o bundle do navegador: SÓ a chave PUBLICÁVEL. Nunca sb_secret_, PAT ou service_role
# (a página se recusa a iniciar se encontrar algo assim).

# https://<ref>.supabase.co
VITE_SUPABASE_URL=
# sb_publishable_…
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: UUID da sala (ex.: a sala it-02c4b-* da C2). Pode ser digitado na tela.
VITE_ORYN_ROOM_ID=
# Opcional: até 4 URLs stun: separadas por vírgula (padrão: stun:stun.l.google.com:19302). TURN nunca aqui: credenciais
# TURN só chegam da Edge Function `turn`, temporárias.
VITE_ORYN_STUN_URLS=
# Opcional: modo ICE padrão (auto, direct, relay ou relay-tls). Vazio: auto (direto quando houver rota, TURN quando
# preciso). relay e relay-tls só para testes técnicos; `?oryn-ice=<modo>` na URL também troca, sem controle na tela.
VITE_ORYN_ICE_MODE=
# Opcional na web (deixe vazio: os links saem do endereço da própria página). Obrigatória no build desktop
# (`pnpm tauri:build`, modo `desktop`): origem pública https://<host> da web, sem barra final, usada nos links de
# convite e de recuperação de senha. Para o desktop, defina em `.env.desktop.local` (ignorado pelo Git).
VITE_ORYN_PUBLIC_ORIGIN=
# Opcional: botão "Continuar com Google". Vazio ou off: oculto. preview: visível só para revisão visual (avisa que
# depende de configuração; nenhum OAuth é iniciado). O fluxo real exige provedor e retorno autorizados à parte.
VITE_ORYN_AUTH_GOOGLE=
