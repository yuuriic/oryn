# Cliente web da POC-02C (voz 1:1). Copie para `.env.local` (ignorado pelo Git) e preencha.
# Tudo aqui vai para o bundle do navegador: SÓ a chave PUBLICÁVEL. Nunca sb_secret_, PAT ou service_role
# (a página se recusa a iniciar se encontrar algo assim).

# https://<ref>.supabase.co
VITE_SUPABASE_URL=
# sb_publishable_…
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: UUID da sala (ex.: a sala it-02c4b-* da C2). Pode ser digitado na tela.
VITE_ORYN_ROOM_ID=
# Opcional: até 4 URLs stun: separadas por vírgula (padrão: stun:stun.l.google.com:19302). Sem TURN.
VITE_ORYN_STUN_URLS=
